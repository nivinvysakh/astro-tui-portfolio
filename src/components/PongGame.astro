---
// Retro 1972 Arcade Pong Mini-Game for Retro TUI Portfolio
---

<div
  id="pong-modal-container"
  class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-xs p-3 sm:p-6 hidden select-none"
>
  <div
    id="pong-game-window"
    class="w-full max-w-2xl border-2 border-[var(--border-active)] bg-[var(--bg-main)] shadow-2xl relative font-mono text-[var(--fg-main)] flex flex-col"
  >
    <!-- Retro Window Title Bar -->
    <div
      class="bg-[var(--status-bar-bg)] border-b border-[var(--border-color)] px-3 py-2 flex items-center justify-between"
    >
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-red-500 inline-block border border-red-700 cursor-pointer" id="pong-win-close"></span>
        <span class="w-3 h-3 rounded-full bg-yellow-500/50 inline-block border border-yellow-700"></span>
        <span class="w-3 h-3 rounded-full bg-emerald-500/50 inline-block border border-emerald-700"></span>
        <span class="font-bold text-xs text-[var(--fg-bright)] ml-1 flex items-center gap-1.5">
          <span>🕹️</span> PONG.EXE [RETRO ARCADE v1.0]
        </span>
      </div>

      <div class="flex items-center gap-3 text-xs">
        <span class="text-[var(--fg-dim)] hidden sm:inline">First to 5 wins</span>
        <button
          id="pong-close-btn"
          class="px-2 py-0.5 border border-[var(--border-color)] bg-[var(--bg-card)] hover:border-red-500 hover:text-red-400 text-xs font-bold transition-colors cursor-pointer"
        >
          ✕ CLOSE [ESC]
        </button>
      </div>
    </div>

    <!-- Scoreboard HUD -->
    <div
      class="bg-[var(--bg-card)] border-b border-[var(--border-color)] px-4 py-2 flex items-center justify-between text-xs"
    >
      <div class="flex items-center gap-2">
        <span class="text-[var(--accent)] font-bold">YOU (P1):</span>
        <span id="pong-score-p1" class="text-base font-bold text-[var(--fg-bright)]">0</span>
      </div>

      <div class="flex items-center gap-4">
        <div class="text-[11px] text-[var(--fg-dim)]">
          HIGH SCORE: <span id="pong-high-score" class="font-bold text-[var(--fg-bright)]">0</span>
        </div>
        <div class="text-[11px] text-[var(--fg-dim)] hidden sm:block">
          RALLY: <span id="pong-rally-count" class="font-bold text-[var(--accent)]">0</span>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <span id="pong-score-cpu" class="text-base font-bold text-[var(--fg-bright)]">0</span>
        <span class="text-red-400 font-bold">:CPU (AI)</span>
      </div>
    </div>

    <!-- Main Canvas Area -->
    <div class="relative bg-black flex items-center justify-center overflow-hidden">
      <canvas
        id="pong-canvas"
        width="640"
        height="380"
        class="w-full h-auto block max-h-[55vh] sm:max-h-[60vh] cursor-none"
      ></canvas>

      <!-- Interactive Overlay Message / Menu -->
      <div
        id="pong-overlay-msg"
        class="absolute inset-0 flex flex-col items-center justify-center bg-black/75 p-4 text-center"
      >
        <div id="pong-overlay-title" class="text-lg sm:text-xl font-bold text-[var(--accent)] mb-2 tracking-wider">
          RETRO PONG
        </div>
        <p id="pong-overlay-desc" class="text-xs sm:text-sm text-[var(--fg-bright)] mb-4 max-w-sm">
          Use <span class="text-[var(--accent)] font-bold">W / S</span> or <span class="text-[var(--accent)] font-bold">↑ / ↓</span> arrows (or Mouse) to move your paddle.
        </p>
        <button
          id="pong-start-btn"
          class="px-5 py-2 border-2 border-[var(--accent)] bg-[var(--bg-card)] hover:bg-[var(--border-color)] text-[var(--fg-bright)] font-bold text-sm tracking-wider transition-transform active:scale-95 cursor-pointer shadow-[0_0_15px_var(--glow-color)]"
        >
          ▶ PRESS SPACE OR CLICK TO PLAY
        </button>
      </div>
    </div>

    <!-- Mobile Touch / On-screen Controls -->
    <div class="flex sm:hidden border-t border-[var(--border-color)] bg-[var(--bg-card)] p-2 justify-between items-center gap-2">
      <button
        id="pong-touch-up"
        class="flex-1 py-3 border border-[var(--border-color)] bg-[var(--bg-main)] text-[var(--fg-bright)] font-bold active:bg-[var(--border-color)] text-sm select-none"
      >
        ▲ UP
      </button>
      <button
        id="pong-touch-down"
        class="flex-1 py-3 border border-[var(--border-color)] bg-[var(--bg-main)] text-[var(--fg-bright)] font-bold active:bg-[var(--border-color)] text-sm select-none"
      >
        ▼ DOWN
      </button>
    </div>

    <!-- Footer Controls Reference Bar -->
    <div
      class="bg-[var(--status-bar-bg)] border-t border-[var(--border-color)] px-3 py-1.5 flex flex-wrap items-center justify-between text-[10px] text-[var(--fg-dim)]"
    >
      <div class="flex items-center gap-3">
        <span><kbd class="px-1 py-0.5 border border-[var(--border-color)] bg-[var(--bg-card)] text-[var(--fg-bright)]">W</kbd> / <kbd class="px-1 py-0.5 border border-[var(--border-color)] bg-[var(--bg-card)] text-[var(--fg-bright)]">S</kbd> or <kbd class="px-1 py-0.5 border border-[var(--border-color)] bg-[var(--bg-card)] text-[var(--fg-bright)]">↑</kbd> <kbd class="px-1 py-0.5 border border-[var(--border-color)] bg-[var(--bg-card)] text-[var(--fg-bright)]">↓</kbd> Move</span>
        <span><kbd class="px-1 py-0.5 border border-[var(--border-color)] bg-[var(--bg-card)] text-[var(--fg-bright)]">Space</kbd> Serve / Pause</span>
        <span><kbd class="px-1 py-0.5 border border-[var(--border-color)] bg-[var(--bg-card)] text-[var(--fg-bright)]">R</kbd> Restart</span>
      </div>
      <div>
        <span><kbd class="px-1 py-0.5 border border-[var(--border-color)] bg-[var(--bg-card)] text-[var(--fg-bright)]">ESC</kbd> / <kbd class="px-1 py-0.5 border border-[var(--border-color)] bg-[var(--bg-card)] text-[var(--fg-bright)]">Q</kbd> Exit</span>
      </div>
    </div>
  </div>
</div>

<script>
  import { playBeep, playSuccessSound, playErrorSound } from "../utils/sound";

  // Game state
  let canvas: HTMLCanvasElement | null = null;
  let ctx: CanvasRenderingContext2D | null = null;
  let animationId: number | null = null;
  let isPongOpen = false;
  let isPlaying = false;
  let isPaused = false;
  let gameOver = false;

  const WIN_SCORE = 5;
  let scoreP1 = 0;
  let scoreCpu = 0;
  let rallyCount = 0;
  let highScore = 0;

  // Paddle & Ball Entities
  const PADDLE_WIDTH = 12;
  const PADDLE_HEIGHT = 70;
  const BALL_SIZE = 10;

  let playerY = 155;
  let cpuY = 155;
  let playerSpeed = 6;
  let cpuSpeed = 4.2;

  let ballX = 320;
  let ballY = 190;
  let ballSpeedX = 5;
  let ballSpeedY = 3;
  const INITIAL_SPEED = 5;

  const keys: Record<string, boolean> = {
    up: false,
    down: false,
  };

  function getThemeColor(): string {
    const theme = document.documentElement.getAttribute("data-theme") || "green";
    switch (theme) {
      case "amber":
        return "#ffb000";
      case "cyan":
        return "#00f0ff";
      case "dracula":
        return "#bd93f9";
      case "mono":
        return "#eeeeee";
      case "cappuccino":
        return "#e69a58";
      case "green":
      default:
        return "#00ff66";
    }
  }

  function getAccentColor(): string {
    const theme = document.documentElement.getAttribute("data-theme") || "green";
    switch (theme) {
      case "amber":
        return "#ffcc00";
      case "cyan":
        return "#ff007f";
      case "dracula":
        return "#ff79c6";
      case "mono":
        return "#00e5ff";
      case "cappuccino":
        return "#e69a58";
      case "green":
      default:
        return "#00ffcc";
    }
  }

  function initGame() {
    canvas = document.getElementById("pong-canvas") as HTMLCanvasElement;
    if (!canvas) return;
    ctx = canvas.getContext("2d");

    // Load High Score
    try {
      const saved = localStorage.getItem("tui_pong_highscore");
      if (saved) {
        highScore = parseInt(saved, 10) || 0;
        updateScoreHUD();
      }
    } catch {}

    resetPositions();
  }

  function resetPositions() {
    if (!canvas) return;
    playerY = canvas.height / 2 - PADDLE_HEIGHT / 2;
    cpuY = canvas.height / 2 - PADDLE_HEIGHT / 2;
    resetBall(1);
  }

  function resetBall(direction: number = 1) {
    if (!canvas) return;
    ballX = canvas.width / 2;
    ballY = canvas.height / 2;
    const angle = (Math.random() * Math.PI) / 4 - Math.PI / 8;
    const speed = INITIAL_SPEED;
    ballSpeedX = direction * speed * Math.cos(angle);
    ballSpeedY = speed * Math.sin(angle);
    rallyCount = 0;
    updateScoreHUD();
  }

  function updateScoreHUD() {
    const elP1 = document.getElementById("pong-score-p1");
    const elCpu = document.getElementById("pong-score-cpu");
    const elHigh = document.getElementById("pong-high-score");
    const elRally = document.getElementById("pong-rally-count");

    if (elP1) elP1.textContent = String(scoreP1);
    if (elCpu) elCpu.textContent = String(scoreCpu);
    if (elHigh) elHigh.textContent = String(highScore);
    if (elRally) elRally.textContent = String(rallyCount);
  }

  function startGame() {
    if (gameOver) {
      scoreP1 = 0;
      scoreCpu = 0;
      gameOver = false;
    }
    isPlaying = true;
    isPaused = false;
    resetPositions();
    updateScoreHUD();

    const overlay = document.getElementById("pong-overlay-msg");
    if (overlay) overlay.classList.add("hidden");

    if (!animationId) {
      animationId = requestAnimationFrame(gameLoop);
    }
  }

  function pauseGame() {
    if (!isPlaying || gameOver) return;
    isPaused = !isPaused;
    const overlay = document.getElementById("pong-overlay-msg");
    const title = document.getElementById("pong-overlay-title");
    const desc = document.getElementById("pong-overlay-desc");
    const btn = document.getElementById("pong-start-btn");

    if (isPaused) {
      if (overlay) overlay.classList.remove("hidden");
      if (title) title.textContent = "GAME PAUSED";
      if (desc) desc.textContent = "Press Space to Resume or ESC to exit.";
      if (btn) btn.textContent = "▶ RESUME MATCH";
    } else {
      if (overlay) overlay.classList.add("hidden");
    }
  }

  function endGame(playerWon: boolean) {
    isPlaying = false;
    gameOver = true;

    if (scoreP1 > highScore) {
      highScore = scoreP1;
      try {
        localStorage.setItem("tui_pong_highscore", String(highScore));
      } catch {}
      updateScoreHUD();
    }

    const overlay = document.getElementById("pong-overlay-msg");
    const title = document.getElementById("pong-overlay-title");
    const desc = document.getElementById("pong-overlay-desc");
    const btn = document.getElementById("pong-start-btn");

    if (playerWon) {
      playSuccessSound();
      if (title) {
        title.textContent = "🏆 VICTORY! YOU WON!";
        title.className = "text-lg sm:text-xl font-bold text-emerald-400 mb-2 tracking-wider";
      }
      if (desc) desc.textContent = `Magnificent rally! Final Score: ${scoreP1} - ${scoreCpu}`;
    } else {
      playErrorSound();
      if (title) {
        title.textContent = "💀 GAME OVER — CPU WON";
        title.className = "text-lg sm:text-xl font-bold text-red-400 mb-2 tracking-wider";
      }
      if (desc) desc.textContent = `Better luck next time! Final Score: ${scoreP1} - ${scoreCpu}`;
    }

    if (btn) btn.textContent = "🔄 PLAY AGAIN";
    if (overlay) overlay.classList.remove("hidden");
  }

  function update() {
    if (!canvas || !isPlaying || isPaused || gameOver) return;

    // Player Paddle Movement
    if (keys.up) {
      playerY = Math.max(5, playerY - playerSpeed);
    }
    if (keys.down) {
      playerY = Math.min(canvas.height - PADDLE_HEIGHT - 5, playerY + playerSpeed);
    }

    // Smart CPU AI Paddle Movement
    const cpuCenter = cpuY + PADDLE_HEIGHT / 2;
    const targetY = ballY + (Math.random() * 20 - 10);
    if (cpuCenter < targetY - 15) {
      cpuY = Math.min(canvas.height - PADDLE_HEIGHT - 5, cpuY + cpuSpeed);
    } else if (cpuCenter > targetY + 15) {
      cpuY = Math.max(5, cpuY - cpuSpeed);
    }

    // Ball Movement
    ballX += ballSpeedX;
    ballY += ballSpeedY;

    // Top & Bottom Wall Collisions
    if (ballY - BALL_SIZE / 2 <= 0) {
      ballY = BALL_SIZE / 2;
      ballSpeedY = -ballSpeedY;
      playBeep(650, 0.03, "sine", 0.03);
    } else if (ballY + BALL_SIZE / 2 >= canvas.height) {
      ballY = canvas.height - BALL_SIZE / 2;
      ballSpeedY = -ballSpeedY;
      playBeep(650, 0.03, "sine", 0.03);
    }

    // Left Paddle (Player) Collision
    const pLeft = 20;
    const pRight = 20 + PADDLE_WIDTH;
    if (
      ballX - BALL_SIZE / 2 <= pRight &&
      ballX + BALL_SIZE / 2 >= pLeft &&
      ballY >= playerY - 5 &&
      ballY <= playerY + PADDLE_HEIGHT + 5 &&
      ballSpeedX < 0
    ) {
      const hitOffset = (ballY - (playerY + PADDLE_HEIGHT / 2)) / (PADDLE_HEIGHT / 2);
      const angle = hitOffset * (Math.PI / 3); // Max 60 degree deflection
      const currentSpeed = Math.min(12, Math.hypot(ballSpeedX, ballSpeedY) + 0.35); // Acceleration
      ballSpeedX = Math.abs(currentSpeed * Math.cos(angle));
      ballSpeedY = currentSpeed * Math.sin(angle);
      ballX = pRight + BALL_SIZE / 2;

      rallyCount++;
      updateScoreHUD();
      playBeep(440, 0.04, "triangle", 0.05);
    }

    // Right Paddle (CPU) Collision
    const cLeft = canvas.width - 20 - PADDLE_WIDTH;
    const cRight = canvas.width - 20;
    if (
      ballX + BALL_SIZE / 2 >= cLeft &&
      ballX - BALL_SIZE / 2 <= cRight &&
      ballY >= cpuY - 5 &&
      ballY <= cpuY + PADDLE_HEIGHT + 5 &&
      ballSpeedX > 0
    ) {
      const hitOffset = (ballY - (cpuY + PADDLE_HEIGHT / 2)) / (PADDLE_HEIGHT / 2);
      const angle = hitOffset * (Math.PI / 3);
      const currentSpeed = Math.min(12, Math.hypot(ballSpeedX, ballSpeedY) + 0.35);
      ballSpeedX = -Math.abs(currentSpeed * Math.cos(angle));
      ballSpeedY = currentSpeed * Math.sin(angle);
      ballX = cLeft - BALL_SIZE / 2;

      rallyCount++;
      updateScoreHUD();
      playBeep(380, 0.04, "triangle", 0.05);
    }

    // Scoring conditions
    if (ballX < 0) {
      // CPU Scored
      scoreCpu++;
      playErrorSound();
      updateScoreHUD();
      if (scoreCpu >= WIN_SCORE) {
        endGame(false);
      } else {
        resetBall(1);
      }
    } else if (ballX > canvas.width) {
      // Player Scored
      scoreP1++;
      playSuccessSound();
      updateScoreHUD();
      if (scoreP1 >= WIN_SCORE) {
        endGame(true);
      } else {
        resetBall(-1);
      }
    }
  }

  function render() {
    const c = ctx;
    const cvs = canvas;
    if (!c || !cvs) return;

    const themeColor = getThemeColor();
    const accentColor = getAccentColor();

    // Clear background with CRT trail
    c.fillStyle = "#050805";
    c.fillRect(0, 0, cvs.width, cvs.height);

    // Draw retro grid / court lines
    c.strokeStyle = "rgba(255, 255, 255, 0.07)";
    c.lineWidth = 2;
    c.strokeRect(5, 5, cvs.width - 10, cvs.height - 10);

    // Dashed center court line
    c.setLineDash([8, 8]);
    c.beginPath();
    c.moveTo(cvs.width / 2, 5);
    c.lineTo(cvs.width / 2, cvs.height - 5);
    c.strokeStyle = "rgba(255, 255, 255, 0.15)";
    c.stroke();
    c.setLineDash([]); // Reset dash

    // Draw Player Paddle
    c.fillStyle = themeColor;
    c.shadowColor = themeColor;
    c.shadowBlur = 10;
    c.fillRect(20, playerY, PADDLE_WIDTH, PADDLE_HEIGHT);

    // Draw CPU Paddle
    c.fillStyle = "#ff5555";
    c.shadowColor = "#ff5555";
    c.shadowBlur = 10;
    c.fillRect(cvs.width - 20 - PADDLE_WIDTH, cpuY, PADDLE_WIDTH, PADDLE_HEIGHT);

    // Draw Retro Square Ball
    c.fillStyle = accentColor;
    c.shadowColor = accentColor;
    c.shadowBlur = 12;
    c.fillRect(
      ballX - BALL_SIZE / 2,
      ballY - BALL_SIZE / 2,
      BALL_SIZE,
      BALL_SIZE
    );

    // Reset shadow
    c.shadowBlur = 0;
  }

  function gameLoop() {
    update();
    render();
    if (isPongOpen) {
      animationId = requestAnimationFrame(gameLoop);
    }
  }

  function togglePong(force?: boolean) {
    const modal = document.getElementById("pong-modal-container");
    if (!modal) return;

    isPongOpen = force !== undefined ? force : !isPongOpen;

    if (isPongOpen) {
      (document.activeElement as HTMLElement)?.blur();
      modal.classList.remove("hidden");
      initGame();
      render();
      if (!animationId) {
        animationId = requestAnimationFrame(gameLoop);
      }
    } else {
      modal.classList.add("hidden");
      isPlaying = false;
      isPaused = false;
      if (animationId) {
        cancelAnimationFrame(animationId);
        animationId = null;
      }
    }
  }

  // Expose global launcher
  (window as unknown as { togglePong: typeof togglePong }).togglePong = togglePong;

  document.addEventListener("DOMContentLoaded", () => {
    initGame();

    const modal = document.getElementById("pong-modal-container");
    const closeBtn = document.getElementById("pong-close-btn");
    const winCloseBtn = document.getElementById("pong-win-close");
    const startBtn = document.getElementById("pong-start-btn");

    closeBtn?.addEventListener("click", () => togglePong(false));
    winCloseBtn?.addEventListener("click", () => togglePong(false));
    startBtn?.addEventListener("click", () => {
      if (isPaused) {
        pauseGame();
      } else {
        startGame();
      }
    });

    // Close on background backdrop click
    modal?.addEventListener("click", (e) => {
      if (e.target === modal) {
        togglePong(false);
      }
    });

    // Canvas Mouse / Pointer Movement
    const pongCanvas = document.getElementById("pong-canvas");
    pongCanvas?.addEventListener("mousemove", (e) => {
      if (!canvas || !isPlaying || isPaused) return;
      const rect = canvas.getBoundingClientRect();
      const mouseY = e.clientY - rect.top;
      const scaleY = canvas.height / rect.height;
      playerY = Math.max(5, Math.min(canvas.height - PADDLE_HEIGHT - 5, mouseY * scaleY - PADDLE_HEIGHT / 2));
    });

    pongCanvas?.addEventListener("click", () => {
      if (!isPlaying) {
        startGame();
      } else if (isPaused) {
        pauseGame();
      }
    });

    // Mobile On-screen Touch Controls
    const touchUp = document.getElementById("pong-touch-up");
    const touchDown = document.getElementById("pong-touch-down");

    touchUp?.addEventListener("touchstart", (e) => {
      e.preventDefault();
      keys.up = true;
    });
    touchUp?.addEventListener("touchend", () => {
      keys.up = false;
    });
    touchDown?.addEventListener("touchstart", (e) => {
      e.preventDefault();
      keys.down = true;
    });
    touchDown?.addEventListener("touchend", () => {
      keys.down = false;
    });

    // Touch drag on canvas for mobile
    pongCanvas?.addEventListener("touchmove", (e) => {
      if (!canvas || !isPlaying || isPaused || e.touches.length === 0) return;
      e.preventDefault();
      const rect = canvas.getBoundingClientRect();
      const touchY = e.touches[0].clientY - rect.top;
      const scaleY = canvas.height / rect.height;
      playerY = Math.max(5, Math.min(canvas.height - PADDLE_HEIGHT - 5, touchY * scaleY - PADDLE_HEIGHT / 2));
    }, { passive: false });
  });

  // Global Keyboard Controls with full page scroll prevention
  document.addEventListener("keydown", (e) => {
    if (!isPongOpen) return;

    const navKeys = ["ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight", " ", "Space", "PageUp", "PageDown"];
    if (navKeys.includes(e.key) || e.code === "Space") {
      e.preventDefault();
    }

    if (e.key === "ArrowUp" || e.key === "w" || e.key === "W") {
      e.preventDefault();
      keys.up = true;
    } else if (e.key === "ArrowDown" || e.key === "s" || e.key === "S") {
      e.preventDefault();
      keys.down = true;
    } else if (e.key === " " || e.code === "Space") {
      e.preventDefault();
      if (!isPlaying) {
        startGame();
      } else {
        pauseGame();
      }
    } else if (e.key === "r" || e.key === "R") {
      e.preventDefault();
      startGame();
    } else if (e.key === "Escape" || e.key === "q" || e.key === "Q") {
      e.preventDefault();
      togglePong(false);
    }
  }, { capture: true });

  document.addEventListener("keyup", (e) => {
    if (!isPongOpen) return;
    if (e.key === "ArrowUp" || e.key === "w" || e.key === "W") {
      keys.up = false;
    }
    if (e.key === "ArrowDown" || e.key === "s" || e.key === "S") {
      keys.down = false;
    }
  }, { capture: true });
</script>

