---
import { PORTFOLIO_DATA } from "../data/portfolio";
import Neofetch from "./Neofetch.astro";
import SpotifyWidget from "./SpotifyWidget.astro";
import GamesWidget from "./GamesWidget.astro";

const { developer, skills, collabs } = PORTFOLIO_DATA;
---

<div
  id="view-gui"
  class="hidden flex flex-col space-y-6 font-mono text-xs md:text-sm"
>
  <!-- Top Neofetch System Summary Card -->
  <Neofetch />

  <!-- Main TUI Grid: Sidebar Directory Navigation + Main Panel -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- Sidebar Navigation Tree -->
    <aside
      class="lg:col-span-3 border border-[var(--border-color)] bg-[var(--bg-card)] p-4 space-y-4"
    >
      <div
        class="text-[var(--accent)] font-bold border-b border-[var(--border-color)] pb-2 flex items-center justify-between"
      >
        <span>📁 EXPLORER</span>
        <span class="text-[10px] text-[var(--fg-dim)]">CONTENTS</span>
      </div>

      <nav class="space-y-1 font-mono text-xs">
        <a
          href="#gui-about"
          class="gui-nav-item flex items-center gap-2 p-1.5 hover:bg-[var(--border-color)] text-[var(--fg-bright)] font-bold transition-colors"
        >
          <span class="text-yellow-400">📄</span> bio.txt (About Me)
        </a>
        <a
          href="#gui-skills"
          class="gui-nav-item flex items-center gap-2 p-1.5 hover:bg-[var(--border-color)] text-[var(--fg-bright)] transition-colors"
        >
          <span class="text-emerald-400">⚙️</span> skills.sh (Skills)
        </a>
        <a
          href="#gui-collabs"
          class="gui-nav-item flex items-center gap-2 p-1.5 hover:bg-[var(--border-color)] text-[var(--fg-bright)] transition-colors"
        >
          <span class="text-purple-400">🤝</span> collabs.md (Collabs)
        </a>
        <a
          href="#gui-github"
          class="gui-nav-item flex items-center gap-2 p-1.5 hover:bg-[var(--border-color)] text-[var(--fg-bright)] transition-colors"
        >
          <span class="text-sky-400">🐙</span> github.sh (GitHub Stats)
        </a>
        <a
          href="#gui-contact"
          class="gui-nav-item flex items-center gap-2 p-1.5 hover:bg-[var(--border-color)] text-[var(--fg-bright)] transition-colors"
        >
          <span class="text-red-400">✉️</span> contact.txt (Contact)
        </a>
        <button
          type="button"
          id="gui-launch-pong"
          class="w-full text-left gui-nav-item flex items-center gap-2 p-1.5 hover:bg-[var(--border-color)] text-[var(--accent)] font-bold transition-colors cursor-pointer border border-dashed border-[var(--border-color)] mt-1"
        >
          <span>🕹️</span> pong.sh (Pong Arcade)
        </button>
        <button
          type="button"
          id="gui-launch-snake"
          class="w-full text-left gui-nav-item flex items-center gap-2 p-1.5 hover:bg-[var(--border-color)] text-emerald-400 font-bold transition-colors cursor-pointer border border-dashed border-[var(--border-color)] mt-1"
        >
          <span>🐍</span> snake.sh (Snake Arcade)
        </button>
        <button
          type="button"
          id="gui-launch-radio"
          class="w-full text-left gui-nav-item flex items-center gap-2 p-1.5 hover:bg-[var(--border-color)] text-pink-400 font-bold transition-colors cursor-pointer border border-dashed border-[var(--border-color)] mt-1"
        >
          <span>📻</span> radio.sh (Lo-Fi Radio)
        </button>
      </nav>

      <!-- Spotify Activity Widget -->
      <SpotifyWidget />

      <!-- Games Activity Widget -->
      <GamesWidget />

      <!-- Quick Metrics -->
      <div
        class="pt-4 border-t border-[var(--border-color)] space-y-2 text-[11px]"
      >
        <div
          class="text-[var(--fg-dim)] font-bold uppercase tracking-wider text-[10px]"
        >
          CONTENT SPEC
        </div>
        <div class="flex justify-between text-[var(--fg-main)]">
          <span>Active Collabs:</span>
          <span class="font-bold text-[var(--fg-bright)]">{collabs.length}</span
          >
        </div>
        <div class="flex justify-between text-[var(--fg-main)]">
          <span>Skill Domains:</span>
          <span class="font-bold text-yellow-400">{skills.length}</span>
        </div>
        <div class="flex justify-between text-[var(--fg-main)]">
          <span>Experience:</span>
          <span class="font-bold text-emerald-400">7+ Years</span>
        </div>
      </div>

      <!-- Quick GitHub Link -->
      <div class="pt-2">
        <a
          href={developer.github}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full text-center block px-3 py-1.5 border border-[var(--border-color)] bg-[var(--bg-main)] hover:border-[var(--border-active)] text-[var(--fg-bright)] text-xs font-bold transition-colors"
        >
          GitHub Profile ↗
        </a>
      </div>
    </aside>

    <!-- Main Content Area -->
    <div class="lg:col-span-9 space-y-8">
      <!-- Section 1: About Me -->
      <section
        id="gui-about"
        class="border border-[var(--border-color)] bg-[var(--bg-card)] p-5 space-y-4"
      >
        <div
          class="flex items-center justify-between border-b border-[var(--border-color)] pb-3"
        >
          <h2
            class="text-base font-bold text-[var(--fg-bright)] flex items-center gap-2"
          >
            <span class="text-[var(--accent)]">></span> CAT BIO.TXT // ABOUT ME
          </h2>
          <span class="text-xs text-[var(--fg-dim)]">[READ-ONLY]</span>
        </div>

        <p class="text-[var(--fg-main)] leading-relaxed text-sm">
          {developer.bio}
        </p>

        {
          developer.quote && (
            <blockquote class="p-3 border-l-2 border-[var(--accent)] bg-[var(--bg-main)] text-[var(--fg-dim)] italic text-xs leading-relaxed">
              {developer.quote}
            </blockquote>
          )
        }

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
          <div
            class="p-3 border border-[var(--border-color)] bg-[var(--bg-main)] space-y-1"
          >
            <span class="text-[10px] text-[var(--fg-dim)] uppercase font-bold"
              >ENGINEERING FOCUS</span
            >
            <div class="text-xs text-[var(--accent)] font-bold">
              Systems Architecture, Edge Systems & Web Performance
            </div>
          </div>
          <div
            class="p-3 border border-[var(--border-color)] bg-[var(--bg-main)] space-y-1"
          >
            <span class="text-[10px] text-[var(--fg-dim)] uppercase font-bold"
              >LOCATION</span
            >
            <div class="text-xs text-[var(--fg-bright)] font-bold">
              📍 {developer.location}
            </div>
          </div>
        </div>
      </section>

      <!-- Section 2: Skills -->
      <section
        id="gui-skills"
        class="border border-[var(--border-color)] bg-[var(--bg-card)] p-5 space-y-4"
      >
        <div
          class="flex items-center justify-between border-b border-[var(--border-color)] pb-3"
        >
          <h2
            class="text-base font-bold text-[var(--fg-bright)] flex items-center gap-2"
          >
            <span class="text-[var(--accent)]">></span> ./SKILLS.SH // TECHNICAL PROFICIENCY
          </h2>
          <span class="text-xs text-[var(--fg-dim)]">[PROFICIENCY METRICS]</span
          >
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {
            skills.map((cat) => (
              <div class="border border-[var(--border-color)] bg-[var(--bg-main)] p-4 space-y-3">
                <div class="text-xs font-bold text-[var(--accent)] flex items-center gap-2 border-b border-[var(--border-color)] pb-2">
                  <span>{cat.icon}</span>
                  <span>{cat.category}</span>
                </div>

                <div class="space-y-2.5">
                  {cat.skills.map((skill) => {
                    const filledCount = Math.round(skill.level / 10);
                    const barStr =
                      "█".repeat(filledCount) + "░".repeat(10 - filledCount);
                    return (
                      <div class="space-y-1">
                        <div class="flex justify-between text-xs font-bold">
                          <span class="text-[var(--fg-bright)]">
                            {skill.name}
                          </span>
                          <span class="text-[var(--fg-dim)] text-[10px]">
                            {skill.experience}
                          </span>
                        </div>
                        <div class="flex items-center gap-2 text-xs">
                          <div class="flex-1 bg-[var(--bg-card)] border border-[var(--border-color)] h-4 overflow-hidden relative flex items-center px-1">
                            <div
                              class="h-full bg-[var(--fg-dim)] opacity-40 absolute left-0 top-0"
                              style={`width: ${skill.level}%`}
                            />
                            <span class="relative z-10 text-[10px] text-[var(--fg-bright)] font-mono">
                              {barStr} {skill.level}%
                            </span>
                          </div>
                          <span class="text-[9px] px-1 bg-[var(--border-color)] text-[var(--accent)] font-bold">
                            {skill.tag}
                          </span>
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Section 3: Collabs (Collaborations) -->
      <section
        id="gui-collabs"
        class="border border-[var(--border-color)] bg-[var(--bg-card)] p-5 space-y-4"
      >
        <div
          class="flex items-center justify-between border-b border-[var(--border-color)] pb-3"
        >
          <h2
            class="text-base font-bold text-[var(--fg-bright)] flex items-center gap-2"
          >
            <span class="text-[var(--accent)]">></span> CAT COLLABS.MD // TEAM COLLABORATIONS
          </h2>
          <span class="text-xs text-[var(--fg-dim)]">[PARTNERSHIPS]</span>
        </div>

        <div class="space-y-4">
          {
            collabs.map((item) => (
              <div class="border border-[var(--border-color)] bg-[var(--bg-main)] p-5 space-y-3 hover:border-[var(--border-active)] transition-all">
                <div class="flex flex-wrap items-center justify-between gap-2 border-b border-[var(--border-color)] pb-2">
                  <h3 class="text-sm font-bold text-[var(--fg-bright)] flex items-center gap-2">
                    <span>🤝</span> {item.title}
                  </h3>
                  <span class="text-[10px] px-2 py-0.5 border border-[var(--border-color)] text-[var(--accent)] uppercase font-bold">
                    {item.partnerType}
                  </span>
                </div>

                {item.asciiLogo && (
                  <pre class="my-2 p-2.5 bg-[var(--bg-card)] text-[10px] sm:text-xs text-[var(--fg-bright)] overflow-x-auto leading-tight select-none border border-[var(--border-color)] font-mono whitespace-pre">{item.asciiLogo}</pre>
                )}

                <div class="text-xs">
                  <span class="text-[var(--accent)] font-bold">
                    Partner Org:
                  </span>{" "}
                  <span class="text-[var(--fg-bright)] font-bold">
                    {item.partner}
                  </span>
                  <span class="mx-2 text-[var(--fg-dim)]">|</span>
                  <span class="text-[var(--accent)] font-bold">Role:</span>{" "}
                  <span class="text-emerald-400 font-bold">{item.role}</span>
                  <span class="mx-2 text-[var(--fg-dim)]">|</span>
                  <span class="text-[var(--fg-dim)]">{item.period}</span>
                </div>

                <p class="text-xs text-[var(--fg-main)] leading-relaxed">
                  {item.description}
                </p>

                <div class="space-y-1 pt-1">
                  <span class="text-[10px] text-[var(--fg-dim)] uppercase font-bold">
                    Key Contributions:
                  </span>
                  <ul class="list-disc list-inside text-xs text-[var(--fg-main)] space-y-0.5">
                    {item.contributions.map((c) => (
                      <li>{c}</li>
                    ))}
                  </ul>
                </div>

                <div class="flex flex-wrap items-center justify-between pt-3 border-t border-[var(--border-color)] gap-2">
                  <div class="flex flex-wrap gap-1">
                    {item.techStack.map((t) => (
                      <span class="text-[10px] px-1.5 py-0.5 bg-[var(--bg-card)] text-[var(--fg-dim)] border border-[var(--border-color)]">
                        {t}
                      </span>
                    ))}
                  </div>

                  {item.link && (
                    <a
                      href={item.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-xs text-[var(--accent)] hover:underline font-bold"
                    >
                      View Project ↗
                    </a>
                  )}
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Section 4: Live GitHub Stats & Repositories -->
      <section
        id="gui-github"
        class="border border-[var(--border-color)] bg-[var(--bg-card)] p-5 space-y-4"
      >
        <div
          class="flex items-center justify-between border-b border-[var(--border-color)] pb-3"
        >
          <h2
            class="text-base font-bold text-[var(--fg-bright)] flex items-center gap-2"
          >
            <span class="text-[var(--accent)]">></span> CAT GITHUB.SH // REPOSITORIES & METRICS
          </h2>
          <span class="text-xs text-emerald-400 font-bold flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            LIVE REST API
          </span>
        </div>

        <div id="gui-gh-loading" class="text-xs text-[var(--fg-dim)] py-2 font-mono">
          Connecting to GitHub API & caching statistics...
        </div>

        <div id="gui-gh-content" class="hidden space-y-4 font-mono">
          <!-- Metric Counter Cards -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            <div class="border border-[var(--border-color)] bg-[var(--bg-main)] p-3 text-center">
              <div class="text-[10px] text-[var(--fg-dim)] font-bold">TOTAL STARS ⭐</div>
              <div id="gui-gh-stars" class="text-lg sm:text-xl font-bold text-yellow-400 mt-1">0</div>
            </div>
            <div class="border border-[var(--border-color)] bg-[var(--bg-main)] p-3 text-center">
              <div class="text-[10px] text-[var(--fg-dim)] font-bold">TOTAL FORKS 🍴</div>
              <div id="gui-gh-forks" class="text-lg sm:text-xl font-bold text-cyan-400 mt-1">0</div>
            </div>
            <div class="border border-[var(--border-color)] bg-[var(--bg-main)] p-3 text-center">
              <div class="text-[10px] text-[var(--fg-dim)] font-bold">PUBLIC REPOS 📦</div>
              <div id="gui-gh-repos" class="text-lg sm:text-xl font-bold text-emerald-400 mt-1">0</div>
            </div>
            <div class="border border-[var(--border-color)] bg-[var(--bg-main)] p-3 text-center">
              <div class="text-[10px] text-[var(--fg-dim)] font-bold">FOLLOWERS 👥</div>
              <div id="gui-gh-followers" class="text-lg sm:text-xl font-bold text-purple-400 mt-1">0</div>
            </div>
          </div>

          <!-- Top Languages Bar -->
          <div class="border border-[var(--border-color)] bg-[var(--bg-main)] p-3 space-y-2">
            <div class="text-[10px] text-[var(--fg-dim)] font-bold uppercase tracking-wider">
              Primary Programming Languages
            </div>
            <div id="gui-gh-lang-list" class="flex flex-wrap gap-2 text-xs"></div>
          </div>

          <!-- Top Repositories Grid -->
          <div class="space-y-2">
            <div class="text-[10px] text-[var(--fg-dim)] font-bold uppercase tracking-wider">
              Featured Repositories
            </div>
            <div id="gui-gh-repos-list" class="grid grid-cols-1 sm:grid-cols-2 gap-3"></div>
          </div>
        </div>
      </section>

      <!-- Section 5: Contact -->
      <section
        id="gui-contact"
        class="border border-[var(--border-color)] bg-[var(--bg-card)] p-5 space-y-4"
      >
        <div
          class="flex items-center justify-between border-b border-[var(--border-color)] pb-3"
        >
          <h2
            class="text-base font-bold text-[var(--fg-bright)] flex items-center gap-2"
          >
            <span class="text-[var(--accent)]">></span> TRANSMIT MAIL // CONTACT
          </h2>
          <span class="text-xs text-[var(--fg-dim)]">[INQUIRIES]</span>
        </div>

        <form
          id="contact-form"
          data-recipient-email={developer.email}
          class="space-y-4"
        >
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="space-y-1">
              <label
                for="contact-name"
                class="text-xs text-[var(--fg-bright)] font-bold block"
                >NAME:</label
              >
              <input
                id="contact-name"
                name="name"
                type="text"
                required
                placeholder="e.g. Linus Torvalds"
                class="w-full bg-[var(--bg-main)] text-[var(--fg-bright)] border border-[var(--border-color)] focus:border-[var(--border-active)] p-2 text-xs font-mono focus:outline-none"
              />
            </div>
            <div class="space-y-1">
              <label
                for="contact-email"
                class="text-xs text-[var(--fg-bright)] font-bold block"
                >EMAIL:</label
              >
              <input
                id="contact-email"
                name="email"
                type="email"
                required
                placeholder="linus@kernel.org"
                class="w-full bg-[var(--bg-main)] text-[var(--fg-bright)] border border-[var(--border-color)] focus:border-[var(--border-active)] p-2 text-xs font-mono focus:outline-none"
              />
            </div>
          </div>

          <div class="space-y-1">
            <label
              for="contact-message"
              class="text-xs text-[var(--fg-bright)] font-bold block"
              >MESSAGE / COLLAB PROPOSAL:</label
            >
            <textarea
              id="contact-message"
              name="message"
              required
              rows="4"
              placeholder="Enter your message or collaboration inquiry..."
              class="w-full bg-[var(--bg-main)] text-[var(--fg-bright)] border border-[var(--border-color)] focus:border-[var(--border-active)] p-2 text-xs font-mono focus:outline-none resize-none"
            ></textarea>
          </div>

          <div
            class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-2"
          >
            <span id="form-status" class="text-xs font-bold hidden"></span>
            <button
              id="contact-submit-btn"
              type="submit"
              class="px-5 py-2 border border-[var(--border-active)] bg-[var(--border-color)] hover:bg-[var(--border-active)] text-[var(--fg-bright)] font-bold text-xs cursor-pointer transition-colors ml-auto"
            >
              <span id="btn-text">SEND PAYLOAD [ENTER]</span>
            </button>
          </div>
        </form>
      </section>
    </div>
  </div>
</div>

<script>
  import confetti from "canvas-confetti";
  import { playSuccessSound } from "../utils/sound";
  import { PORTFOLIO_DATA } from "../data/portfolio";
  import { fetchGitHubStats } from "../utils/github";

  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("contact-form") as HTMLFormElement;
    const statusMsg = document.getElementById("form-status");
    const submitBtn = document.getElementById(
      "contact-submit-btn",
    ) as HTMLButtonElement;
    const btnText = document.getElementById("btn-text");
    const recipientEmail = PORTFOLIO_DATA.developer.email;

    // Fetch and populate live GitHub stats
    initGitHubStats();

    async function initGitHubStats() {
      const loadingEl = document.getElementById("gui-gh-loading");
      const contentEl = document.getElementById("gui-gh-content");
      const starsEl = document.getElementById("gui-gh-stars");
      const forksEl = document.getElementById("gui-gh-forks");
      const reposEl = document.getElementById("gui-gh-repos");
      const followersEl = document.getElementById("gui-gh-followers");
      const langListEl = document.getElementById("gui-gh-lang-list");
      const reposListEl = document.getElementById("gui-gh-repos-list");

      const stats = await fetchGitHubStats();
      if (!stats) {
        if (loadingEl) loadingEl.textContent = "GitHub metrics temporarily offline / rate-limited.";
        return;
      }

      if (loadingEl) loadingEl.classList.add("hidden");
      if (contentEl) contentEl.classList.remove("hidden");

      if (starsEl) starsEl.textContent = String(stats.totalStars);
      if (forksEl) forksEl.textContent = String(stats.totalForks);
      if (reposEl) reposEl.textContent = String(stats.publicRepos);
      if (followersEl) followersEl.textContent = String(stats.followers);

      if (langListEl) {
        langListEl.innerHTML = "";
        stats.topLanguages.forEach((lang) => {
          const badge = document.createElement("span");
          badge.className = "px-2 py-1 bg-[var(--bg-card)] border border-[var(--border-color)] text-[var(--fg-bright)] flex items-center gap-1.5";
          badge.innerHTML = `<span class="text-[var(--accent)] font-bold">${lang.name}</span> <span class="text-[var(--fg-dim)] text-[10px]">(${lang.percentage}%)</span>`;
          langListEl.appendChild(badge);
        });
      }

      if (reposListEl) {
        reposListEl.innerHTML = "";
        stats.topRepos.forEach((repo) => {
          const card = document.createElement("a");
          card.href = repo.url;
          card.target = "_blank";
          card.rel = "noopener noreferrer";
          card.className = "border border-[var(--border-color)] bg-[var(--bg-main)] p-3 hover:border-[var(--accent)] transition-all flex flex-col justify-between block group";
          card.innerHTML = `
            <div>
              <div class="flex items-center justify-between gap-2 border-b border-[var(--border-color)] pb-1.5 mb-1.5">
                <span class="text-xs font-bold text-[var(--fg-bright)] group-hover:text-[var(--accent)] truncate">📦 ${repo.name}</span>
                <span class="text-[10px] text-[var(--accent)] font-bold shrink-0">⭐ ${repo.stars}</span>
              </div>
              <p class="text-[11px] text-[var(--fg-dim)] line-clamp-2 leading-tight">${repo.description}</p>
            </div>
            <div class="flex items-center justify-between text-[10px] text-[var(--fg-dim)] pt-2 mt-2 border-t border-[var(--border-color)]">
              <span class="text-emerald-400 font-bold">${repo.language}</span>
              <span>Updated ${repo.updatedAt} ↗</span>
            </div>
          `;
          reposListEl.appendChild(card);
        });
      }
    }

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();

      const nameInput = document.getElementById(
        "contact-name",
      ) as HTMLInputElement;
      const emailInput = document.getElementById(
        "contact-email",
      ) as HTMLInputElement;
      const messageInput = document.getElementById(
        "contact-message",
      ) as HTMLTextAreaElement;

      const name = nameInput.value.trim();
      const email = emailInput.value.trim();
      const message = messageInput.value.trim();

      if (!name || !email || !message) return;

      // Loading state
      if (submitBtn) submitBtn.disabled = true;
      if (btnText) btnText.textContent = "TRANSMITTING...";
      if (statusMsg) {
        statusMsg.className = "text-xs font-bold text-yellow-400 block";
        statusMsg.textContent = "⏳ Encrypting & dispatching email payload...";
      }

      try {
        const response = await fetch(
          `https://formsubmit.co/ajax/${recipientEmail}`,
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Accept: "application/json",
            },
            body: JSON.stringify({
              name,
              email,
              message,
              _subject: `Portfolio Contact from ${name}`,
              _captcha: "false",
            }),
          },
        );

        if (response.ok) {
          playSuccessSound();

          confetti({
            particleCount: 80,
            spread: 60,
            origin: { y: 0.7 },
            colors: ["#00ff66", "#00f0ff", "#ffb000", "#bd93f9"],
          });

          if (statusMsg) {
            statusMsg.className = "text-xs font-bold text-emerald-400 block";
            statusMsg.textContent =
              "✓ Message payload successfully transmitted!";
            setTimeout(() => {
              statusMsg.className = "text-xs font-bold hidden";
              statusMsg.textContent = "";
            }, 7000);
          }
          form.reset();
        } else {
          throw new Error(`HTTP ${response.status}`);
        }
      } catch (err) {
        if (statusMsg) {
          statusMsg.className = "text-xs font-bold text-rose-400 block";
          statusMsg.textContent =
            "✖ Transmission failed. Please try again later.";
        }
      } finally {
        if (submitBtn) submitBtn.disabled = false;
        if (btnText) btnText.textContent = "SEND PAYLOAD [ENTER]";
      }
    });

    document.getElementById("gui-launch-pong")?.addEventListener("click", () => {
      const win = window as unknown as {
        togglePong?: (f?: boolean) => void;
      };
      if (win.togglePong) {
        win.togglePong(true);
        playSuccessSound();
      }
    });

    document.getElementById("gui-launch-snake")?.addEventListener("click", () => {
      const win = window as unknown as {
        toggleSnake?: (f?: boolean) => void;
      };
      if (win.toggleSnake) {
        win.toggleSnake(true);
        playSuccessSound();
      }
    });

    document.getElementById("gui-launch-radio")?.addEventListener("click", () => {
      const win = window as unknown as {
        radioEngine?: { toggleModal: (f?: boolean) => void };
      };
      if (win.radioEngine) {
        win.radioEngine.toggleModal(true);
        playSuccessSound();
      }
    });
  });
</script>
