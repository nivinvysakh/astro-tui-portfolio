---
// Retro Arcade Snake Mini-Game for Retro TUI Portfolio
---

<div
  id="snake-modal-container"
  class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-xs p-2 sm:p-6 hidden select-none overflow-y-auto py-4 sm:py-6"
>
  <div
    id="snake-game-window"
    class="w-full max-w-lg max-h-[94vh] sm:max-h-[90vh] border-2 border-[var(--border-active)] bg-[var(--bg-main)] shadow-2xl relative font-mono text-[var(--fg-main)] flex flex-col my-auto overflow-hidden rounded-sm"
  >
    <!-- Retro Window Title Bar -->
    <div
      class="bg-[var(--status-bar-bg)] border-b border-[var(--border-color)] px-3 py-2 flex items-center justify-between"
    >
      <div class="flex items-center gap-2">
        <span
          class="w-3 h-3 rounded-full bg-red-500 inline-block border border-red-700 cursor-pointer"
          id="snake-win-close"></span>
        <span
          class="w-3 h-3 rounded-full bg-yellow-500/50 inline-block border border-yellow-700"
        ></span>
        <span
          class="w-3 h-3 rounded-full bg-emerald-500/50 inline-block border border-emerald-700"
        ></span>
        <span
          class="font-bold text-[11px] sm:text-xs text-[var(--fg-bright)] ml-1 flex items-center gap-1.5 truncate"
        >
          <span>🐍</span>
          <span class="inline sm:hidden">SNAKE.EXE</span>
          <span class="hidden sm:inline">SNAKE.EXE [RETRO NOSTALGIA v1.0]</span>
        </span>
      </div>

      <button
        id="snake-close-btn"
        class="px-2 py-0.5 border border-[var(--border-color)] bg-[var(--bg-card)] hover:border-red-500 hover:text-red-400 text-xs font-bold transition-colors cursor-pointer"
      >
        ✕ CLOSE [ESC]
      </button>
    </div>

    <!-- Scoreboard HUD -->
    <div
      class="bg-[var(--bg-card)] border-b border-[var(--border-color)] px-4 py-2 flex items-center justify-between text-xs"
    >
      <div class="flex items-center gap-2">
        <span class="text-[var(--accent)] font-bold">SCORE:</span>
        <span id="snake-score" class="text-base font-bold text-[var(--fg-bright)]">0</span>
      </div>

      <div class="flex items-center gap-4 text-[11px] text-[var(--fg-dim)]">
        <div>
          LENGTH: <span id="snake-length" class="font-bold text-[var(--fg-bright)]">3</span>
        </div>
        <div>
          HIGH SCORE: <span id="snake-high-score" class="font-bold text-[var(--accent)]">0</span>
        </div>
      </div>
    </div>

    <!-- Main Canvas Area -->
    <div class="relative bg-black flex items-center justify-center overflow-hidden p-2">
      <canvas
        id="snake-canvas"
        width="400"
        height="400"
        class="w-full max-w-[380px] h-auto block aspect-square border border-[var(--border-color)]"
      ></canvas>

      <!-- Interactive Overlay Message / Menu -->
      <div
        id="snake-overlay-msg"
        class="absolute inset-0 flex flex-col items-center justify-center bg-black/80 p-4 text-center"
      >
        <div
          id="snake-overlay-title"
          class="text-lg sm:text-xl font-bold text-[var(--accent)] mb-2 tracking-wider"
        >
          RETRO SNAKE
        </div>
        <p
          id="snake-overlay-desc"
          class="text-xs text-[var(--fg-bright)] mb-4 max-w-xs"
        >
          Use <span class="text-[var(--accent)] font-bold">W / A / S / D</span> or <span class="text-[var(--accent)] font-bold">Arrow Keys</span> to steer. Eat apples to grow!
        </p>
        <button
          id="snake-start-btn"
          class="px-4 sm:px-5 py-1.5 sm:py-2 border-2 border-[var(--accent)] bg-[var(--bg-card)] hover:bg-[var(--border-color)] text-[var(--fg-bright)] font-bold text-xs sm:text-sm tracking-wider transition-transform active:scale-95 cursor-pointer shadow-[0_0_15px_var(--glow-color)]"
        >
          ▶ TAP TO PLAY
        </button>
      </div>
    </div>

    <!-- Mobile Touch D-Pad Controls -->
    <div
      class="flex flex-col items-center justify-center p-3 border-t border-[var(--border-color)] bg-[var(--bg-card)] sm:hidden gap-1.5"
    >
      <button
        id="snake-touch-up"
        class="w-16 py-2 border border-[var(--border-color)] bg-[var(--bg-main)] text-[var(--fg-bright)] font-bold active:bg-[var(--border-color)] text-xs rounded"
      >
        ▲
      </button>
      <div class="flex gap-4">
        <button
          id="snake-touch-left"
          class="w-16 py-2 border border-[var(--border-color)] bg-[var(--bg-main)] text-[var(--fg-bright)] font-bold active:bg-[var(--border-color)] text-xs rounded"
        >
          ◀
        </button>
        <button
          id="snake-touch-down"
          class="w-16 py-2 border border-[var(--border-color)] bg-[var(--bg-main)] text-[var(--fg-bright)] font-bold active:bg-[var(--border-color)] text-xs rounded"
        >
          ▼
        </button>
        <button
          id="snake-touch-right"
          class="w-16 py-2 border border-[var(--border-color)] bg-[var(--bg-main)] text-[var(--fg-bright)] font-bold active:bg-[var(--border-color)] text-xs rounded"
        >
          ▶
        </button>
      </div>
    </div>

    <!-- Footer Controls Reference Bar -->
    <div
      class="bg-[var(--status-bar-bg)] border-t border-[var(--border-color)] px-3 py-1.5 text-[10px] text-[var(--fg-dim)] shrink-0"
    >
      <!-- Desktop Shortcuts -->
      <div class="hidden sm:flex items-center justify-between">
        <div class="flex items-center gap-3">
          <span><kbd class="px-1 py-0.5 border border-[var(--border-color)] bg-[var(--bg-card)] text-[var(--fg-bright)]">W/A/S/D</kbd> or <kbd class="px-1 py-0.5 border border-[var(--border-color)] bg-[var(--bg-card)] text-[var(--fg-bright)]">↑←↓→</kbd> Steer</span>
          <span><kbd class="px-1 py-0.5 border border-[var(--border-color)] bg-[var(--bg-card)] text-[var(--fg-bright)]">Space</kbd> Pause</span>
          <span><kbd class="px-1 py-0.5 border border-[var(--border-color)] bg-[var(--bg-card)] text-[var(--fg-bright)]">R</kbd> Restart</span>
        </div>
        <div>
          <span><kbd class="px-1 py-0.5 border border-[var(--border-color)] bg-[var(--bg-card)] text-[var(--fg-bright)]">ESC</kbd> Close</span>
        </div>
      </div>

      <!-- Mobile Hint -->
      <div class="flex sm:hidden items-center justify-between font-mono text-[9px]">
        <span>📱 Touch D-Pad to Steer</span>
        <span>Tap <kbd class="px-1 py-0.5 border border-[var(--border-color)] bg-[var(--bg-card)] text-[var(--fg-bright)]">CLOSE ✕</kbd> to Exit</span>
      </div>
    </div>
  </div>
</div>

<script>
  import { playBeep, playSuccessSound, playErrorSound } from "../utils/sound";

  const GRID_SIZE = 20;
  const CELL_COUNT = 20; // 20x20 grid = 400x400

  interface Point {
    x: number;
    y: number;
  }

  let canvas: HTMLCanvasElement | null = null;
  let ctx: CanvasRenderingContext2D | null = null;
  let gameInterval: number | null = null;

  let snake: Point[] = [];
  let food: Point = { x: 10, y: 10 };
  let dir: Point = { x: 1, y: 0 };
  let nextDir: Point = { x: 1, y: 0 };

  let score = 0;
  let highScore = 0;
  let isSnakeOpen = false;
  let isPlaying = false;
  let isPaused = false;
  let isGameOver = false;
  let speedMs = 110;

  function getThemeColor(): string {
    const theme = document.documentElement.getAttribute("data-theme") || "green";
    switch (theme) {
      case "amber": return "#ffb000";
      case "cyan": return "#00f0ff";
      case "dracula": return "#bd93f9";
      case "mono": return "#eeeeee";
      case "cappuccino": return "#e69a58";
      case "green":
      default: return "#00ff66";
    }
  }

  function getAccentColor(): string {
    const theme = document.documentElement.getAttribute("data-theme") || "green";
    switch (theme) {
      case "amber": return "#ffcc00";
      case "cyan": return "#ff007f";
      case "dracula": return "#ff79c6";
      case "mono": return "#00e5ff";
      case "cappuccino": return "#e69a58";
      case "green":
      default: return "#00ffcc";
    }
  }

  function initGame() {
    canvas = document.getElementById("snake-canvas") as HTMLCanvasElement;
    if (!canvas) return;
    ctx = canvas.getContext("2d");

    // Load High Score
    try {
      const saved = localStorage.getItem("tui_snake_highscore");
      if (saved) {
        highScore = parseInt(saved, 10) || 0;
        updateHUD();
      }
    } catch {}

    resetState();
  }

  function resetState() {
    snake = [
      { x: 10, y: 10 },
      { x: 9, y: 10 },
      { x: 8, y: 10 },
    ];
    dir = { x: 1, y: 0 };
    nextDir = { x: 1, y: 0 };
    score = 0;
    speedMs = 110;
    spawnFood();
    updateHUD();
  }

  function spawnFood() {
    let valid = false;
    while (!valid) {
      food = {
        x: Math.floor(Math.random() * CELL_COUNT),
        y: Math.floor(Math.random() * CELL_COUNT),
      };
      valid = !snake.some((s) => s.x === food.x && s.y === food.y);
    }
  }

  function updateHUD() {
    const scoreEl = document.getElementById("snake-score");
    const lenEl = document.getElementById("snake-length");
    const highEl = document.getElementById("snake-high-score");

    if (scoreEl) scoreEl.textContent = String(score);
    if (lenEl) lenEl.textContent = String(snake.length);
    if (highEl) highEl.textContent = String(highScore);
  }

  function startGame() {
    if (isGameOver) {
      resetState();
      isGameOver = false;
    }
    isPlaying = true;
    isPaused = false;

    const overlay = document.getElementById("snake-overlay-msg");
    if (overlay) overlay.classList.add("hidden");

    if (gameInterval) clearInterval(gameInterval);
    gameInterval = window.setInterval(gameStep, speedMs);
  }

  function pauseGame() {
    if (!isPlaying || isGameOver) return;
    isPaused = !isPaused;

    const overlay = document.getElementById("snake-overlay-msg");
    const title = document.getElementById("snake-overlay-title");
    const desc = document.getElementById("snake-overlay-desc");
    const btn = document.getElementById("snake-start-btn");

    if (isPaused) {
      if (gameInterval) clearInterval(gameInterval);
      if (overlay) overlay.classList.remove("hidden");
      if (title) title.textContent = "GAME PAUSED";
      if (desc) desc.textContent = "Press Space to Resume or ESC to exit.";
      if (btn) btn.textContent = "▶ RESUME GAME";
    } else {
      if (overlay) overlay.classList.add("hidden");
      gameInterval = window.setInterval(gameStep, speedMs);
    }
  }

  function gameOverGame() {
    isPlaying = false;
    isGameOver = true;
    if (gameInterval) clearInterval(gameInterval);

    if (score > highScore) {
      highScore = score;
      playSuccessSound();
      try {
        localStorage.setItem("tui_snake_highscore", String(highScore));
      } catch {}
      updateHUD();
    } else {
      playErrorSound();
    }

    const overlay = document.getElementById("snake-overlay-msg");
    const title = document.getElementById("snake-overlay-title");
    const desc = document.getElementById("snake-overlay-desc");
    const btn = document.getElementById("snake-start-btn");

    if (overlay) overlay.classList.remove("hidden");
    if (title) {
      title.textContent = "💀 GAME OVER";
      title.className = "text-lg sm:text-xl font-bold text-red-400 mb-2 tracking-wider";
    }
    if (desc) desc.textContent = `You scored ${score} points! (Length: ${snake.length})`;
    if (btn) btn.textContent = "🔄 PLAY AGAIN";
  }

  function gameStep() {
    if (!isPlaying || isPaused || isGameOver) return;

    dir = { ...nextDir };
    const head: Point = {
      x: snake[0].x + dir.x,
      y: snake[0].y + dir.y,
    };

    // Wall collision
    if (head.x < 0 || head.x >= CELL_COUNT || head.y < 0 || head.y >= CELL_COUNT) {
      gameOverGame();
      return;
    }

    // Self collision
    if (snake.some((s) => s.x === head.x && s.y === head.y)) {
      gameOverGame();
      return;
    }

    snake.unshift(head);

    // Food collision
    if (head.x === food.x && head.y === food.y) {
      score += 10;
      playBeep(880, 0.05, "triangle", 0.06);
      spawnFood();
      updateHUD();

      // Progressive speed boost
      if (speedMs > 60 && score % 40 === 0) {
        speedMs -= 5;
        if (gameInterval) {
          clearInterval(gameInterval);
          gameInterval = window.setInterval(gameStep, speedMs);
        }
      }
    } else {
      snake.pop();
    }

    render();
  }

  function render() {
    const c = ctx;
    const cvs = canvas;
    if (!c || !cvs) return;
    const themeColor = getThemeColor();
    const accentColor = getAccentColor();

    // Background
    c.fillStyle = "#050805";
    c.fillRect(0, 0, cvs.width, cvs.height);

    // Grid lines
    c.strokeStyle = "rgba(255, 255, 255, 0.04)";
    c.lineWidth = 1;
    for (let i = 0; i < CELL_COUNT; i++) {
      c.beginPath();
      c.moveTo(i * GRID_SIZE, 0);
      c.lineTo(i * GRID_SIZE, cvs.height);
      c.stroke();

      c.beginPath();
      c.moveTo(0, i * GRID_SIZE);
      c.lineTo(cvs.width, i * GRID_SIZE);
      c.stroke();
    }

    // Draw Apple Food
    c.fillStyle = "#ff4444";
    c.shadowColor = "#ff4444";
    c.shadowBlur = 10;
    c.fillRect(
      food.x * GRID_SIZE + 2,
      food.y * GRID_SIZE + 2,
      GRID_SIZE - 4,
      GRID_SIZE - 4
    );

    // Draw Snake
    snake.forEach((segment, idx) => {
      if (idx === 0) {
        // Glowing Head
        c.fillStyle = accentColor;
        c.shadowColor = accentColor;
        c.shadowBlur = 12;
      } else {
        c.fillStyle = themeColor;
        c.shadowColor = themeColor;
        c.shadowBlur = 4;
      }

      c.fillRect(
        segment.x * GRID_SIZE + 1,
        segment.y * GRID_SIZE + 1,
        GRID_SIZE - 2,
        GRID_SIZE - 2
      );
    });

    c.shadowBlur = 0;
  }

  function toggleSnake(force?: boolean) {
    const modal = document.getElementById("snake-modal-container");
    if (!modal) return;

    isSnakeOpen = force !== undefined ? force : !isSnakeOpen;

    if (isSnakeOpen) {
      (document.activeElement as HTMLElement)?.blur();
      modal.classList.remove("hidden");
      initGame();
      render();
    } else {
      modal.classList.add("hidden");
      isPlaying = false;
      isPaused = false;
      if (gameInterval) clearInterval(gameInterval);
    }
  }

  // Global window API
  (window as unknown as { toggleSnake: typeof toggleSnake }).toggleSnake = toggleSnake;

  document.addEventListener("DOMContentLoaded", () => {
    initGame();

    const modal = document.getElementById("snake-modal-container");
    const closeBtn = document.getElementById("snake-close-btn");
    const winCloseBtn = document.getElementById("snake-win-close");
    const startBtn = document.getElementById("snake-start-btn");

    closeBtn?.addEventListener("click", () => toggleSnake(false));
    winCloseBtn?.addEventListener("click", () => toggleSnake(false));
    
    const handleStart = (e?: Event) => {
      if (e) e.preventDefault();
      if (isPaused) pauseGame();
      else startGame();
    };

    startBtn?.addEventListener("click", handleStart);
    startBtn?.addEventListener("touchstart", handleStart, { passive: false });

    // Mobile D-Pad Touch Buttons (Zero-latency touchstart + click)
    const bindTouchDir = (id: string, newDir: Point) => {
      const el = document.getElementById(id);
      if (!el) return;
      const handler = (e: Event) => {
        e.preventDefault();
        if ((newDir.x !== 0 && dir.x === 0) || (newDir.y !== 0 && dir.y === 0)) {
          nextDir = newDir;
        }
      };
      el.addEventListener("touchstart", handler, { passive: false });
      el.addEventListener("pointerdown", handler);
      el.addEventListener("click", handler);
    };

    bindTouchDir("snake-touch-up", { x: 0, y: -1 });
    bindTouchDir("snake-touch-down", { x: 0, y: 1 });
    bindTouchDir("snake-touch-left", { x: -1, y: 0 });
    bindTouchDir("snake-touch-right", { x: 1, y: 0 });

    // Modal background click
    modal?.addEventListener("click", (e) => {
      if (e.target === modal) toggleSnake(false);
    });
  });

  // Global Keyboard Controls with full page scroll prevention
  document.addEventListener("keydown", (e) => {
    if (!isSnakeOpen) return;

    const navKeys = ["ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight", " ", "Space", "PageUp", "PageDown"];
    if (navKeys.includes(e.key) || e.code === "Space") {
      e.preventDefault();
    }

    if (e.key === "ArrowUp" || e.key === "w" || e.key === "W") {
      e.preventDefault();
      if (dir.y === 0) nextDir = { x: 0, y: -1 };
    } else if (e.key === "ArrowDown" || e.key === "s" || e.key === "S") {
      e.preventDefault();
      if (dir.y === 0) nextDir = { x: 0, y: 1 };
    } else if (e.key === "ArrowLeft" || e.key === "a" || e.key === "A") {
      e.preventDefault();
      if (dir.x === 0) nextDir = { x: -1, y: 0 };
    } else if (e.key === "ArrowRight" || e.key === "d" || e.key === "D") {
      e.preventDefault();
      if (dir.x === 0) nextDir = { x: 1, y: 0 };
    } else if (e.key === " " || e.code === "Space") {
      e.preventDefault();
      if (!isPlaying) startGame();
      else pauseGame();
    } else if (e.key === "r" || e.key === "R") {
      e.preventDefault();
      startGame();
    } else if (e.key === "Escape" || e.key === "q" || e.key === "Q") {
      e.preventDefault();
      toggleSnake(false);
    }
  }, { capture: true });
</script>

